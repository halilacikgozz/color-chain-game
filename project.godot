config_version=5

[application]
config/name="Color Chain"
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/number_chain.tscn"
config/quit_on_go_back=false
boot_splash/show_image=false
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=480
window/size/viewport_height=920
window/size/window_width_override=480
window/size/window_height_override=920
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.188, 0.192, 0.216, 1)

[input_devices]
pointing/emulate_mouse_from_touch=false
